{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "node scripts/preparePublicUploads.js",
  "builds": [
    {
      "src": "apiServer.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "uploads/menu/**",
          "public/menu-images/**",
          "lib/**"
        ]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/"
    },
    {
      "source": "/og/(.*)",
      "destination": "/apiServer.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/apiServer.js"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ],
  "headers": [
    {
      "source": "/menu-images/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Restaurant-Id, x-restaurant-id, X-Requested-With, Accept, Origin" },
        { "key": "Access-Control-Expose-Headers", "value": "X-Total-Count, X-Limit, X-Offset" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Restaurant-Id, x-restaurant-id" }
      ]
    }
  ]
}
