# Copy to `.env` in the repo root for local MySQL, or set the same keys
# on the Node app at https://backend.u-menus.com/

# Production domains:
#   Frontend  https://u-menus.com/
#   Backend   https://backend.u-menus.com/
# Flutter production build MUST use:
#   flutter build web --release --dart-define=API_BASE_URL=https://backend.u-menus.com/api

# Local Docker (docker-compose.mysql.yml maps 3307 -> 3306):
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=almenupro
MYSQL_PASSWORD=almenupro
MYSQL_DATABASE=almenupro

# Shared host / cPanel example (uncomment and replace):
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=cpanel_db_user
# MYSQL_PASSWORD=cpanel_db_password
# MYSQL_DATABASE=cpanel_db_name

# Optional instead of the five keys above:
# MYSQL_URL=mysql://almenupro:almenupro@127.0.0.1:3307/almenupro

# Keep Mongo unset so the API uses MySQL:
# MONGODB_URI=

ADMIN_AUTH_SECRET=change-me
SUPER_ADMIN_USER=superadmin
SUPER_ADMIN_PASSWORD=change-me
FRONTEND_URL=https://u-menus.com
FRONTEND_ORIGIN=https://u-menus.com
PORT=3000
