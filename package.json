{
  "name": "almenupro-api",
  "version": "1.6.0",
  "private": true,
  "main": "apiServer.js",
  "scripts": {
    "start": "node apiServer.js",
    "seed": "node seedFromTalabat.js",
    "test:cors": "node scripts/cors-smoke.js",
    "build:talabat-bookmarklet": "node tools/build-talabat-bookmarklet.js",
    "test:talabat-import": "node --test test/talabat-bookmarklet-import.test.js",
    "test:external-orders": "node --test test/externalOrders.test.js",
    "test:inventory": "node --test test/inventory-avco.test.js",
    "test:mysql": "node scripts/mysql-smoke.js",
    "process:platform-sales:today": "node scripts/process-todays-platform-orders.js",
    "export:mysql": "node scripts/export-mysql-dump.js",
    "build": "node scripts/preparePublicUploads.js",
    "build:frontend": "bash frontend/scripts/build.sh",
    "deploy:api:railway": "railway up",
    "deploy:frontend:pages": "npm run build:frontend && npx wrangler pages deploy frontend/dist --project-name=almenupro-frontend"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "mongodb": "^6.16.0",
    "mysql2": "^3.24.5"
  }
}
