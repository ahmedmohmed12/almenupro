{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "bash scripts/build.sh",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/customers",
      "destination": "/customers.html"
    },
    {
      "source": "/ar/customers",
      "destination": "/customers.html"
    },
    {
      "source": "/smart-seller",
      "destination": "/smart-seller.html"
    },
    {
      "source": "/create",
      "destination": "/create.html"
    },
    {
      "source": "/ar/create",
      "destination": "/create.html"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/menu/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/restaurant/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/r/:slug/links",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|slackbot|discordbot|linkedinbot|preview).*"
        }
      ],
      "destination": "https://backend-henna-chi-76.vercel.app/og/r/:slug/links"
    },
    {
      "source": "/r/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/legacy-menu",
      "destination": "/app.html"
    },
    {
      "source": "/:slug",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(js|json|wasm|png|jpg|jpeg|webp|svg|ico|woff2|ttf|frag|html)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
