# Railway / local API
PORT=3000
HOST=0.0.0.0
MONGODB_URI=
ADMIN_AUTH_SECRET=change-me

# CORS & public URLs (set after deploy)
FRONTEND_URL=https://your-project.pages.dev
BACKEND_PUBLIC_URL=https://your-api.up.railway.app
# Optional comma-separated extra origins
ALLOWED_ORIGINS=
# Set to 1 to allow only Cloudflare Pages + allowlist (blocks other https Origins)
STRICT_CORS=

# Flutter web build (also accepts VITE_API_URL without /api suffix)
API_BASE_URL=https://your-api.up.railway.app/api